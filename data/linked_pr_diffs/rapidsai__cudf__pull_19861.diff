+
+    def test_null_values(self):
+        """Test handling of null values in decimal division"""
+        s1 = cudf.Series([Decimal("1.23"), None, Decimal("4.56")])
+        s2 = cudf.Series([Decimal("2.0"), Decimal("3.0"), Decimal("4.0")])
