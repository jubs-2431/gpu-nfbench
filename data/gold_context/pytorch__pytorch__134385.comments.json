    "body": "for flex_attention i used a hack. hope it helps (or makes it into the codebase if it's correct)\n\n```\nimport torch\nfrom torch._higher_order_ops.flex_attention import flex_attention, flex_attention_backward\nfrom torch._C import DispatchKey\nfrom torch.utils.flop_counter import _FlopCounterMode\n\n    def attention_flops(query, key, value, block_mask):\n        b, h, s_q, d_q = query.shape\n        s_k = key.shape[2]\n        d_v = value.shape[3]\n        total_flops = b * h * s_q * s_k * 2 * d_q + b * h * s_q * d_v * 2 * s_k\n\n        # calculate block mask ratio\n        # block_mask is a tuple: (seq_len_q, seq_len_kv, kv_num_blocks, kv_indices, \n        #                          full_kv_num_blocks, full_kv_indices, q_num_blocks, q_indices,\n        #                          full_q_num_blocks, full_q_indices, q_block_size, kv_block_size, mask_mod)\n        if block_mask is None:\n            block_mask_ratio = 1.0  # dense attention, all blocks computed\n        else:\n            seq_len_q = block_mask[0]\n            seq_len_kv = block_mask[1]\n            kv_num_blocks = block_mask[2]\n            q_block_size = block_mask[10]\n            kv_block_size = block_mask[11]\n            num_rows = (seq_len_q + q_block_size - 1) // q_block_size\n            num_cols = (seq_len_kv + kv_block_size - 1) // kv_block_size\n            total_blocks = num_rows * num_cols\n            present_blocks = kv_num_blocks.sum().item()\n            block_mask_ratio = present_blocks / total_blocks if total_blocks > 0 else 1.0\n\n        return total_flops * block_mask_ratio\n\n    # patch flex_attention to have an approximate flop counter\n    @flex_attention.py_impl(_FlopCounterMode)  # Note: _FlopCounterMode with underscore\n    @torch._dynamo.disable()\n    def flex_attention_flop_counter(\n        mode, query, key, value, score_mod=None, block_mask=None, \n        scale=None, kernel_options=None, score_mod_other_buffers=(), \n        mask_mod_other_buffers=(), *args, **kwargs\n    ):\n        # Calculate FLOPs based on tensor shapes\n        total_flops = attention_flops(query, key, value, block_mask)\n\n        # Record FLOPs\n        for par in set(mode.counter.mod_tracker.parents):\n            mode.counter.flop_counts[par][flex_attention] += total_flops\n\n        # Call flex_attention with CompositeExplicitAutograd dispatch key\n        # This bypasses our _FlopCounterMode py_impl\n        return flex_attention.dispatch(\n            DispatchKey.CompositeExplicitAutograd,\n            query, key, value,\n            score_mod=score_mod,\n            block_mask=block_mask,\n            scale=scale,\n            kernel_options=kernel_options,\n            score_mod_other_buffers=score_mod_other_buffers,\n            mask_mod_other_buffers=mask_mod_other_buffers,\n            *args, **kwargs\n        )\n\n    @flex_attention_backward.py_impl(_FlopCounterMode)\n    @torch._dynamo.disable()\n    def flex_attention_backward_flop_counter(\n        mode, query, key, value, out, logsumexp, grad_out, grad_logsumexp,\n        fw_graph, joint_graph, block_mask, scale, kernel_options,\n        score_mod_other_buffers=(), mask_mod_other_buffers=(), *args, **kwargs\n    ):\n        # Calculate FLOPs based on tensor shapes\n        total_flops = attention_flops(query, key, value, block_mask)\n        # Double the FLOPs for the backward pass (calculation + gradient update)\n        total_flops *= 2\n\n        # Record FLOPs\n        for par in set(mode.counter.mod_tracker.parents):\n            mode.counter.flop_counts[par][flex_attention_backward] += total_flops\n\n        # Call flex_attention_backward with CompositeExplicitAutograd dispatch key\n        # This bypasses our _FlopCounterMode py_impl\n        return flex_attention_backward.dispatch(\n            DispatchKey.CompositeExplicitAutograd,\n            query, key, value, out, logsumexp, grad_out, grad_logsumexp,\n            fw_graph, joint_graph, block_mask, scale, kernel_options,\n            score_mod_other_buffers, mask_mod_other_buffers,\n            *args, **kwargs\n        )\n```",
